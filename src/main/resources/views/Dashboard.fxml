<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">
    
    <!-- Top Menu Bar -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>
            <Menu text="Books">
                <MenuItem text="Manage Books" onAction="#showBookManagement"/>
            </Menu>
            <Menu text="Members">
                <MenuItem text="Manage Members" onAction="#showMemberManagement"/>
            </Menu>
            <Menu text="Transactions">
                <MenuItem text="Issue Book" onAction="#showIssueBook"/>
                <MenuItem text="Return Book" onAction="#showReturnBook"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#showAbout"/>
            </Menu>
        </MenuBar>
    </top>
    
    <!-- Center Content Area -->
    <center>
        <VBox spacing="20" styleClass="content-pane">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            
            <!-- Title -->
            <Label text="Library Management System" styleClass="label-title"/>
            <Label text="Welcome to the Library Management System" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
            
            <Separator/>
            
            <!-- Dashboard Statistics -->
            <GridPane hgap="20" vgap="20">
                <!-- Total Books -->
                <VBox styleClass="content-pane" style="-fx-background-color: #E3F2FD;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Total Books" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    <Label fx:id="totalBooksLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
                </VBox>
                
                <!-- Total Members -->
                <VBox styleClass="content-pane" style="-fx-background-color: #E8F5E9;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Total Members" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    <Label fx:id="totalMembersLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                </VBox>
                
                <!-- Currently Issued -->
                <VBox styleClass="content-pane" style="-fx-background-color: #FFF3E0;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Currently Issued" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    <Label fx:id="currentlyIssuedLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
                </VBox>
                
                <!-- Overdue Books -->
                <VBox styleClass="content-pane" style="-fx-background-color: #FFEBEE;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Overdue Books" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    <Label fx:id="overdueLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #F44336;"/>
                </VBox>
            </GridPane>
            
            <Separator/>
            
            <!-- Quick Actions -->
            <Label text="Quick Actions" styleClass="label-header"/>
            <HBox spacing="15">
                <Button text="Manage Books" styleClass="button" onAction="#showBookManagement"/>
                <Button text="Manage Members" styleClass="button" onAction="#showMemberManagement"/>
                <Button text="Issue Book" styleClass="button-success" onAction="#showIssueBook"/>
                <Button text="Return Book" styleClass="button-warning" onAction="#showReturnBook"/>
            </HBox>
            
        </VBox>
    </center>
    
    <!-- Bottom Status Bar -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>
    </bottom>
    
</BorderPane>
