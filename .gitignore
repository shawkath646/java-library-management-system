# .gitignore for Library Management System (Maven Project)

# Compiled class files
*.class
target/

# Log files
*.log

# Package Files (but keep lib/javafx-sdk for distribution)
*.jar
!lib/**/*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven
.mvn/
mvnw
mvnw.cmd

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/launch.json

# MacOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# IDE specific files
*.iml
.idea/
*.swp
*.bak
*~
.classpath
.project
.settings/

# Temporary files
*.tmp
*.pptx
~$Presentation.pptx
*.pdf

# Database credentials (optional - uncomment to protect)
# src/main/java/utils/DBUtil.java

# Distribution folder
dist/
